# .env.example
# Copy to .env and fill the values. NEVER commit real keys.

# Runpod credentials
RUNPOD_API_KEY=
RUNPOD_MODEL_ID=

# Brightdata proxy URL (optional)
# Examples:
# BRIGHTDATA_PROXY=http://username:password@proxy.luminati.io:22225
# or
# BRIGHTDATA_PROXY=http://token@proxy.brightdata.com:22225
BRIGHTDATA_PROXY=

# Local dev settings (optional)
PORT=8000
